{
  "name": "@ikomida/shared-logics",
  "version": "0.0.19",
  "description": "This is the shared logics between services, UI and workers etc...",
  "private": false,
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "browser": "lib/index.browser.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf ./build ./lib ./docs && tsc && rollup -c",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf ./build ./lib ./docs",
    "glogin": "npx google-artifactregistry-auth",
    "prepare": "yarn build",
    "prepublishOnly": "yarn lint",
    "preversion": "yarn lint",
    "version": "yarn format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "author": "Khalid Ait Bellahs (Ti Alti Nivel)",
  "license": "UNLICENSED",
  "dependencies": {
    "@ikomida/shared-types": "^0.0.27",
    "luxon": "^3.0.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.19.4",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-typescript": "^8.4.0",
    "@types/luxon": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^5.36.1",
    "@typescript-eslint/parser": "^5.36.1",
    "eslint": "^8.9.0",
    "eslint-config-prettier": "^8.5.0",
    "jsdoc": "^3.6.10",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.67.2",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.4.0",
    "typedoc": "^0.22.11",
    "typescript": "^4.8.2"
  }
}
