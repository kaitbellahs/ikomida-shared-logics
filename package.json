{
  "name": "@ikomida/shared-logics",
  "version": "1.1.1",
  "description": "This is the shared logics between services, UI and workers etc...",
  "private": false,
  "types": "./lib/main.d.ts",
  "type": "module",
  "exports": {
    "node": {
      "import": "./lib/main.mjs",
      "require": "./lib/main.cjs"
    },
    "default": "./lib/main.js",
    "package.json": "./package.json"
  },
  "files": [
    "./lib/",
    "./README.md",
    "./package.json"
  ],
  "scripts": {
    "build": "yarn clean && rollup -c",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir ./build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out ./docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf ./build ./lib ./docs",
    "local": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn build",
    "glogin": "artifactregistry-auth"
  },
  "author": "Khalid Ait Bellahs (Ti Alti Nivel)",
  "license": "UNLICENSED",
  "dependencies": {
    "luxon": "^3.0.4"
  },
  "peerDependencies": {
    "@ikomida/shared-types": "*",
    "@types/uuid": "*",
    "uuid": "*"
  },
  "devDependencies": {
    "@ikomida/shared-types": "^1.3.11",
    "@types/uuid": "^8.3.4",
    "uuid": "^9.0.0",
    "@microsoft/api-extractor": "^7.33.5",
    "@rollup/plugin-commonjs": "^23.0.2",
    "@rollup/plugin-json": "^5.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^9.0.2",
    "@types/luxon": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^5.41.0",
    "@typescript-eslint/parser": "^5.41.0",
    "eslint": "^8.26.0",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "jsdoc": "^3.6.11",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^3.2.3",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.19",
    "typescript": "^4.8.4"
  }
}