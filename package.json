{
  "name": "@ikomida/shared-logics",
  "version": "0.2.0",
  "description": "This is the shared logics between services, UI and workers etc...",
  "private": false,
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "browser": "lib/index.browser.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "yarn clean && rollup -c",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf ./build ./lib ./docs",
    "glogin": "artifactregistry-auth"
  },
  "author": "Khalid Ait Bellahs (Ti Alti Nivel)",
  "license": "UNLICENSED",
  "dependencies": {
    "@ikomida/shared-types": "^1.0.2",
    "@types/uuid": "^8.3.4",
    "luxon": "^3.0.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.32.0",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/luxon": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "jsdoc": "^3.6.11",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.15",
    "typescript": "^4.8.4"
  }
}